<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CineVerse - Ultra Cinema Experience & Ticket Booking</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- Google Fonts: Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Outfit', 'sans-serif'],
          },
          colors: {
            brand: {
              amber: '#f59e0b',
              glow: '#fbbf24',
              violet: '#8b5cf6',
              neon: '#a855f7',
              dark: '#0a0a0f',
              card: '#12121c',
              elevated: '#1a1a2b',
              border: '#2a2a40'
            }
          },
          boxShadow: {
            'glow-amber': '0 0 25px -5px rgba(245, 158, 11, 0.45)',
            'glow-violet': '0 0 25px -5px rgba(139, 92, 246, 0.45)',
            'screen-glow': '0 15px 45px rgba(245, 158, 11, 0.35)'
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0a0a0f;
    }
    ::-webkit-scrollbar-thumb {
      background: #272738;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f3f58;
    }

    /* Screen Curvature */
    .theater-screen-arc {
      border-radius: 50% / 100% 100% 0 0;
      transform: perspective(600px) rotateX(-20deg);
    }

    /* Perforated ticket edge style */
    .ticket-rip-left {
      position: relative;
    }
    .ticket-rip-left::before {
      content: '';
      position: absolute;
      left: -12px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      background-color: #0a0a0f;
      border-radius: 50%;
      z-index: 20;
    }
    .ticket-rip-right {
      position: relative;
    }
    .ticket-rip-right::after {
      content: '';
      position: absolute;
      right: -12px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      background-color: #0a0a0f;
      border-radius: 50%;
      z-index: 20;
    }

    /* Pulse animation for active neon effects */
    @keyframes subtlePulse {
      0%, 100% { opacity: 0.85; filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.4)); }
      50% { opacity: 1; filter: drop-shadow(0 0 20px rgba(245, 158, 11, 0.7)); }
    }
    .neon-pulse {
      animation: subtlePulse 3s infinite ease-in-out;
    }
  </style>
</head>

<body class="bg-brand-dark text-slate-100 font-sans min-h-screen selection:bg-brand-amber selection:text-black relative overflow-x-hidden">

  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-40 backdrop-blur-md bg-brand-dark/85 border-b border-brand-border/60 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3 cursor-pointer" onclick="scrollToCatalog()">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-brand-violet to-fuchsia-500 p-0.5 shadow-glow-amber">
          <div class="w-full h-full bg-brand-dark rounded-[10px] flex items-center justify-center">
            <i data-lucide="clapperboard" class="w-5 h-5 text-brand-amber"></i>
          </div>
        </div>
        <div>
          <span class="font-display font-extrabold text-2xl tracking-tight bg-gradient-to-r from-amber-400 via-amber-200 to-purple-300 bg-clip-text text-transparent">
            Cine<span class="text-brand-amber">Verse</span>
          </span>
          <span class="hidden sm:inline-block text-[10px] tracking-widest uppercase font-semibold text-slate-400 ml-1.5 px-1.5 py-0.5 bg-slate-800/80 rounded border border-slate-700">IMAX 4K</span>
        </div>
      </div>

      <!-- Search & Filters -->
      <div class="flex-1 max-w-md hidden md:block">
        <div class="relative">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
          <input 
            type="text" 
            id="searchInput"
            placeholder="Search movies, actors, genres..."
            class="w-full pl-10 pr-4 py-2 text-sm bg-brand-card/90 border border-brand-border rounded-full text-slate-200 placeholder-slate-500 focus:outline-none focus:border-brand-amber/70 focus:ring-1 focus:ring-brand-amber transition"
            onkeyup="filterMovies()"
          />
        </div>
      </div>

      <!-- Location & User Action Controls -->
      <div class="flex items-center gap-3 sm:gap-4">
        <!-- City Selector -->
        <div class="relative flex items-center bg-brand-card border border-brand-border rounded-full px-3 py-1.5 text-xs text-slate-300">
          <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-amber mr-1.5"></i>
          <select id="citySelect" class="bg-transparent text-slate-200 focus:outline-none cursor-pointer pr-2 font-medium">
            <option value="New York" class="bg-brand-card text-white">New York (Lincoln Sq)</option>
            <option value="Los Angeles" class="bg-brand-card text-white">Los Angeles (Universal)</option>
            <option value="London" class="bg-brand-card text-white">London (BFI IMAX)</option>
            <option value="Tokyo" class="bg-brand-card text-white">Tokyo (Shinjuku)</option>
          </select>
        </div>

        <!-- History / Tickets Drawer Trigger -->
        <button 
          onclick="toggleTicketsDrawer(true)" 
          class="relative flex items-center justify-center p-2 rounded-full bg-brand-card hover:bg-brand-elevated border border-brand-border transition group"
          title="My Bookings"
        >
          <i data-lucide="ticket" class="w-4 h-4 text-slate-300 group-hover:text-brand-amber transition"></i>
          <span id="ticketBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-brand-amber text-black text-[10px] font-bold rounded-full flex items-center justify-center">0</span>
        </button>

        <!-- Profile Mock -->
        <div class="flex items-center gap-2 pl-2 border-l border-brand-border">
          <img 
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" 
            alt="User avatar" 
            class="w-8 h-8 rounded-full ring-2 ring-brand-amber/50 object-cover"
            onerror="this.src='https://placehold.co/100x100/222/fff?text=CV'"
          />
          <span class="hidden lg:block text-xs font-medium text-slate-300">Alex Carter</span>
        </div>
      </div>

    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-4 pb-12 sm:py-16">
    <!-- Ambient backdrops -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-b from-brand-amber/15 via-purple-600/10 to-transparent blur-3xl pointer-events-none -z-10"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="heroCard" class="relative rounded-3xl overflow-hidden border border-brand-border bg-gradient-to-r from-brand-card via-brand-dark/95 to-brand-card p-6 sm:p-10 lg:p-12 shadow-2xl min-h-[460px] flex flex-col justify-end">
        
        <!-- Hero Movie Background Banner Image -->
        <div class="absolute inset-0 z-0">
          <img 
            id="heroBackdrop"
            src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=1600&auto=format&fit=crop&q=80" 
            alt="Cinematic Banner" 
            class="w-full h-full object-cover object-center opacity-30 filter brightness-90 transition duration-700"
            onerror="this.src='https://placehold.co/1600x900/111/444?text=CineVerse+Cinema'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/70 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-transparent to-brand-dark/50"></div>
        </div>

        <!-- Hero Content Info -->
        <div class="relative z-10 max-w-2xl space-y-4">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="px-3 py-1 text-xs font-extrabold uppercase tracking-wider bg-brand-amber text-black rounded-full shadow-glow-amber">
              Featured Premiere
            </span>
            <span class="px-2.5 py-1 text-xs font-semibold bg-white/10 text-white backdrop-blur-md rounded-md flex items-center gap-1 border border-white/15">
              <i data-lucide="star" class="w-3.5 h-3.5 text-brand-amber fill-brand-amber"></i> 8.9 IMDb
            </span>
            <span class="px-2.5 py-1 text-xs text-slate-300 bg-slate-800/80 rounded-md border border-slate-700">
              PG-13 • 2h 46m
            </span>
            <span class="px-2.5 py-1 text-xs font-medium text-purple-300 bg-purple-950/60 border border-purple-800/60 rounded-md">
              IMAX 70MM Laser
            </span>
          </div>

          <h1 id="heroTitle" class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-tight">
            Interstellar Odyssey: Beyond Time
          </h1>

          <p id="heroSynopsis" class="text-sm sm:text-base text-slate-300 line-clamp-3 leading-relaxed">
            When humanity's time draws to an end, a courageous vanguard voyages across the cosmic horizons into an uncharted wormhole to safeguard our species' destiny. An awe-inspiring sonic journey mixed exclusively for IMAX.
          </p>

          <div class="pt-3 flex flex-wrap items-center gap-3">
            <button 
              onclick="startBookingFlow(movies[0])" 
              class="px-7 py-3.5 rounded-xl font-display font-bold text-sm bg-gradient-to-r from-brand-amber to-amber-500 hover:from-amber-400 hover:to-amber-500 text-black shadow-glow-amber transition transform hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2"
            >
              <i data-lucide="ticket" class="w-4 h-4"></i> Book Tickets Now
            </button>
            <button 
              onclick="openTrailerModal('Interstellar Odyssey: Beyond Time')"
              class="px-5 py-3.5 rounded-xl font-medium text-sm bg-slate-800/80 hover:bg-slate-700/90 text-white backdrop-blur border border-slate-700 transition flex items-center gap-2"
            >
              <i data-lucide="play" class="w-4 h-4 text-brand-amber"></i> Watch Trailer
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Movie Catalog Section -->
  <main id="catalogSection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    
    <!-- Filter Tabs & Stats -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-brand-border pb-6 mb-8">
      <div>
        <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-2.5">
          <i data-lucide="film" class="w-6 h-6 text-brand-amber"></i>
          Explore Showtimes
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Select a film to reserve luxury recliner seats with instant confirmation</p>
      </div>

      <div class="flex items-center gap-2 p-1 bg-brand-card border border-brand-border rounded-xl">
        <button 
          id="tabNowShowing" 
          onclick="setMovieTab('now-showing')" 
          class="px-4 py-2 rounded-lg text-xs font-semibold bg-brand-amber text-black transition shadow"
        >
          Now Showing
        </button>
        <button 
          id="tabComingSoon" 
          onclick="setMovieTab('coming-soon')" 
          class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition"
        >
          Coming Soon
        </button>
      </div>
    </div>

    <!-- Movie Grid Cards Container -->
    <div id="movieGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <!-- Injected via JavaScript -->
    </div>

    <!-- Empty search result fallback -->
    <div id="noMoviesFallback" class="hidden text-center py-16">
      <i data-lucide="film-slash" class="w-12 h-12 text-slate-600 mx-auto mb-3"></i>
      <h3 class="font-display font-semibold text-lg text-slate-300">No movies found</h3>
      <p class="text-sm text-slate-500 mt-1">Try another title, genre, or change your selected city.</p>
    </div>
  </main>

  <!-- Booking Flow Modal Overlay -->
  <div id="bookingModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-2 sm:p-4 overflow-y-auto">
    <div class="relative w-full max-w-5xl bg-brand-card border border-brand-border rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[94vh] my-auto">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-6 border-b border-brand-border/80 bg-brand-elevated/40 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand-amber/10 border border-brand-amber/30 flex items-center justify-center text-brand-amber">
            <i data-lucide="clapperboard" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 id="modalMovieTitle" class="font-display font-bold text-lg sm:text-xl text-white">Select Experience</h3>
            <p id="modalMovieMeta" class="text-xs text-slate-400">Step 1 of 4 • Cinema & Showtime</p>
          </div>
        </div>

        <button 
          onclick="closeBookingModal()" 
          class="p-2 rounded-full hover:bg-slate-800 text-slate-400 hover:text-white transition"
        >
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Step Indicator Tracker -->
      <div class="grid grid-cols-4 bg-brand-dark border-b border-brand-border text-center text-xs font-medium">
        <div id="stepTab1" class="py-2.5 px-1 border-b-2 border-brand-amber text-brand-amber flex items-center justify-center gap-1.5 font-semibold">
          <span class="w-5 h-5 rounded-full bg-brand-amber text-black text-[11px] flex items-center justify-center font-bold">1</span>
          <span class="hidden sm:inline">Time & Venue</span>
        </div>
        <div id="stepTab2" class="py-2.5 px-1 border-b-2 border-transparent text-slate-500 flex items-center justify-center gap-1.5 font-semibold">
          <span class="w-5 h-5 rounded-full bg-slate-800 text-slate-400 text-[11px] flex items-center justify-center font-bold">2</span>
          <span class="hidden sm:inline">Seats</span>
        </div>
        <div id="stepTab3" class="py-2.5 px-1 border-b-2 border-transparent text-slate-500 flex items-center justify-center gap-1.5 font-semibold">
          <span class="w-5 h-5 rounded-full bg-slate-800 text-slate-400 text-[11px] flex items-center justify-center font-bold">3</span>
          <span class="hidden sm:inline">Snacks</span>
        </div>
        <div id="stepTab4" class="py-2.5 px-1 border-b-2 border-transparent text-slate-500 flex items-center justify-center gap-1.5 font-semibold">
          <span class="w-5 h-5 rounded-full bg-slate-800 text-slate-400 text-[11px] flex items-center justify-center font-bold">4</span>
          <span class="hidden sm:inline">Checkout</span>
        </div>
      </div>

      <!-- Modal Body Scrollable Steps Container -->
      <div class="p-4 sm:p-6 overflow-y-auto flex-1">
        
        <!-- ================= STEP 1: DATE, CINEMA & SHOWTIME ================= -->
        <div id="stepContent1" class="space-y-6">
          <!-- Date Pill Picker -->
          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mb-3 flex items-center gap-2">
              <i data-lucide="calendar" class="w-4 h-4 text-brand-amber"></i> Select Date
            </label>
            <div id="datePillsContainer" class="flex gap-2.5 overflow-x-auto pb-2 scrollbar-none">
              <!-- Dynamically populated dates -->
            </div>
          </div>

          <!-- Cinema Venue & Format Selection -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mb-2">Cinema Location</label>
              <select id="venueSelect" class="w-full bg-brand-elevated border border-brand-border rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-amber">
                <option value="Grand Luxe Dolby Screening 1">CineVerse Downtown Grand Luxe (Screen 1)</option>
                <option value="Skyline Laser IMAX Hall 4">CineVerse Skyline Laser IMAX (Hall 4)</option>
                <option value="Galaxy VIP Lounge Screen">CineVerse Galaxy VIP Club Lounge</option>
              </select>
            </div>
            <div>
              <label class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mb-2">Projection Format</label>
              <div class="grid grid-cols-3 gap-2" id="formatSelector">
                <button type="button" onclick="selectFormat('IMAX 3D', 20)" class="format-btn active px-3 py-2 text-xs font-semibold rounded-xl border border-brand-amber bg-brand-amber/10 text-brand-amber">IMAX 3D</button>
                <button type="button" onclick="selectFormat('Dolby Atmos', 18)" class="format-btn px-3 py-2 text-xs font-semibold rounded-xl border border-brand-border bg-brand-elevated text-slate-300">Dolby Atmos</button>
                <button type="button" onclick="selectFormat('Standard 4K', 14)" class="format-btn px-3 py-2 text-xs font-semibold rounded-xl border border-brand-border bg-brand-elevated text-slate-300">Standard 4K</button>
              </div>
            </div>
          </div>

          <!-- Showtime Slots -->
          <div>
            <label class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mb-3 flex items-center gap-2">
              <i data-lucide="clock" class="w-4 h-4 text-brand-amber"></i> Available Showtimes
            </label>
            <div id="showtimeSlots" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <!-- Dynamically injected showtimes -->
            </div>
          </div>
        </div>

        <!-- ================= STEP 2: INTERACTIVE SEAT MAP ================= -->
        <div id="stepContent2" class="hidden space-y-6">
          
          <!-- Screen Visual Curve -->
          <div class="flex flex-col items-center justify-center pt-2">
            <div class="w-3/4 max-w-lg h-3 bg-gradient-to-r from-transparent via-amber-400 to-transparent rounded-full shadow-screen-glow neon-pulse"></div>
            <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mt-2.5 flex items-center gap-1.5">
              <i data-lucide="monitor" class="w-3.5 h-3.5 text-brand-amber"></i> Curved Cinema Screen This Way
            </p>
          </div>

          <!-- Seat Legend -->
          <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 py-2 border-y border-brand-border/60 text-xs">
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 rounded-md bg-slate-700/80 border border-slate-600"></div>
              <span class="text-slate-300">Available</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 rounded-md bg-brand-amber shadow-glow-amber border border-amber-300"></div>
              <span class="text-brand-amber font-semibold">Selected</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 rounded-md bg-slate-900 border border-slate-800 opacity-40"></div>
              <span class="text-slate-500">Sold / Reserved</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 rounded-md bg-purple-950 border border-purple-600 flex items-center justify-center text-[10px] text-purple-300">
                <i data-lucide="sparkles" class="w-2.5 h-2.5"></i>
              </div>
              <span class="text-purple-300">VIP Recliner ($22)</span>
            </div>
          </div>

          <!-- Seat Grid Container -->
          <div class="overflow-x-auto pb-4 pt-1">
            <div id="seatMapLayout" class="min-w-[580px] flex flex-col items-center gap-2.5">
              <!-- Rendered via renderSeatMap() -->
            </div>
          </div>

          <!-- Quick Selection Details Footer -->
          <div class="bg-brand-elevated/70 border border-brand-border p-3.5 rounded-2xl flex items-center justify-between text-xs sm:text-sm">
            <div>
              <span class="text-slate-400">Selected Seats:</span>
              <span id="selectedSeatsList" class="font-bold text-brand-amber ml-1.5">None</span>
            </div>
            <div>
              <span class="text-slate-400">Seats Subtotal:</span>
              <span id="seatsSubtotalDisplay" class="font-bold text-white text-base ml-1.5">$0.00</span>
            </div>
          </div>
        </div>

        <!-- ================= STEP 3: FOOD & BEVERAGE ADD-ONS ================= -->
        <div id="stepContent3" class="hidden space-y-5">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="font-display font-semibold text-white">Artisan Concessions & Bites</h4>
              <p class="text-xs text-slate-400">Pre-order freshly made snacks to be delivered right to your luxury seat</p>
            </div>
            <span class="text-xs px-2.5 py-1 rounded bg-brand-amber/15 text-brand-amber border border-brand-amber/30">Delivered to Seat</span>
          </div>

          <div id="concessionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Populated via Javascript -->
          </div>
        </div>

        <!-- ================= STEP 4: ORDER SUMMARY & CHECKOUT ================= -->
        <div id="stepContent4" class="hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Summary Card -->
            <div class="lg:col-span-2 bg-brand-elevated/70 border border-brand-border rounded-2xl p-5 space-y-4">
              <h4 class="font-display font-bold text-base text-white border-b border-brand-border/60 pb-3 flex items-center gap-2">
                <i data-lucide="receipt" class="w-4 h-4 text-brand-amber"></i> Reservation Summary
              </h4>

              <div class="space-y-3 text-sm">
                <div class="flex justify-between items-center pb-2 border-b border-brand-border/40">
                  <span class="text-slate-400">Movie & Venue</span>
                  <span id="summaryMovie" class="font-medium text-white text-right">-</span>
                </div>
                <div class="flex justify-between items-center pb-2 border-b border-brand-border/40">
                  <span class="text-slate-400">Time & Projection</span>
                  <span id="summarySchedule" class="font-medium text-white text-right">-</span>
                </div>
                <div class="flex justify-between items-center pb-2 border-b border-brand-border/40">
                  <span class="text-slate-400">Allocated Seats</span>
                  <span id="summarySeats" class="font-medium text-brand-amber text-right">-</span>
                </div>
                <div class="flex justify-between items-center pb-2 border-b border-brand-border/40">
                  <span class="text-slate-400">Snacks & Concessions</span>
                  <span id="summarySnacks" class="font-medium text-slate-300 text-right">-</span>

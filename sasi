        pill.className = `date-pill flex-shrink-0 px-4 py-2.5 rounded-2xl border text-center transition ${i === 0 ? 'border-brand-amber bg-brand-amber/15 text-brand-amber font-bold' : 'border-brand-border bg-brand-elevated text-slate-400 hover:text-white hover:border-slate-600'}`;
        pill.innerHTML = `
          <span class="block text-[10px] uppercase font-semibold">${dayName}</span>
          <span class="block text-base font-extrabold text-white mt-0.5">${dateNum}</span>
          <span class="block text-[10px] text-slate-400">${monthName}</span>
        `;
        pill.onclick = () => {
          document.querySelectorAll('.date-pill').forEach(el => {
            el.className = 'date-pill flex-shrink-0 px-4 py-2.5 rounded-2xl border text-center transition border-brand-border bg-brand-elevated text-slate-400 hover:text-white hover:border-slate-600';
          });
          pill.className = 'date-pill flex-shrink-0 px-4 py-2.5 rounded-2xl border text-center transition border-brand-amber bg-brand-amber/15 text-brand-amber font-bold';
          state.selectedDate = dateString;
          soundButtonClick();
        };

        if (i === 0) state.selectedDate = dateString;
        container.appendChild(pill);
      }
    }

    function initShowtimes() {
      const container = document.getElementById('showtimeSlots');
      container.innerHTML = '';
      const slots = [
        { time: '11:00 AM', tag: 'Morning Matinee', price: 14 },
        { time: '02:30 PM', tag: 'Afternoon Prime', price: 16 },
        { time: '07:30 PM', tag: 'Laser Premiere', price: 20 },
        { time: '10:45 PM', tag: 'Late Night Dolby', price: 18 }
      ];

      slots.forEach((slot, index) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `slot-btn text-left p-3 rounded-2xl border transition ${index === 2 ? 'border-brand-amber bg-brand-amber/10 ring-1 ring-brand-amber' : 'border-brand-border bg-brand-elevated hover:border-slate-600'}`;
        btn.innerHTML = `
          <div class="flex items-center justify-between mb-1">
            <span class="font-display font-extrabold text-base text-white">${slot.time}</span>
            <span class="text-[10px] font-bold text-brand-amber bg-brand-amber/20 px-1.5 py-0.5 rounded">$${slot.price}</span>
          </div>
          <span class="text-[11px] text-slate-400 block">${slot.tag}</span>
        `;
        btn.onclick = () => {
          document.querySelectorAll('.slot-btn').forEach(el => {
            el.className = 'slot-btn text-left p-3 rounded-2xl border border-brand-border bg-brand-elevated hover:border-slate-600 transition';
          });
          btn.className = 'slot-btn text-left p-3 rounded-2xl border border-brand-amber bg-brand-amber/10 ring-1 ring-brand-amber transition';
          state.selectedTime = slot.time;
          soundButtonClick();
        };
        container.appendChild(btn);
      });
    }

    function selectFormat(name, basePrice) {
      state.selectedFormat = name;
      state.formatPrice = basePrice;
      document.querySelectorAll('.format-btn').forEach(b => {
        if (b.innerText.includes(name)) {
          b.className = 'format-btn active px-3 py-2 text-xs font-semibold rounded-xl border border-brand-amber bg-brand-amber/10 text-brand-amber';
        } else {
          b.className = 'format-btn px-3 py-2 text-xs font-semibold rounded-xl border border-brand-border bg-brand-elevated text-slate-300';
        }
      });
      soundButtonClick();
      updateSeatsSubtotal();
    }

    const seatRows = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
    const seatCols = 12;
    // Deterministic mock sold seats
    const soldSeats = new Set(['B3', 'B4', 'D6', 'D7', 'E8', 'E9', 'F1', 'F2', 'H6', 'H7']);

    function renderSeatMap() {
      const container = document.getElementById('seatMapLayout');
      container.innerHTML = '';

      seatRows.forEach((rowLetter, rIndex) => {
        const rowWrapper = document.createElement('div');
        rowWrapper.className = 'flex items-center gap-2 sm:gap-2.5';

        // Row label
        const label = document.createElement('span');
        label.className = 'w-5 text-[11px] font-bold text-slate-500 text-center';
        label.innerText = rowLetter;
        rowWrapper.appendChild(label);

        // Tier classification: Rows G, H = VIP Recliner, Rows D-F = Premium, A-C = Standard
        let tier = 'Standard';
        let tierPrice = 12;
        if (['G', 'H'].includes(rowLetter)) {
          tier = 'VIP';
          tierPrice = 22;
        } else if (['D', 'E', 'F'].includes(rowLetter)) {
          tier = 'Premium';
          tierPrice = 16;
        }

        const seatsInner = document.createElement('div');
        seatsInner.className = 'flex items-center gap-1.5 sm:gap-2';

        for (let col = 1; col <= seatCols; col++) {
          const seatId = `${rowLetter}${col}`;
          const isSold = soldSeats.has(seatId);
          const isSelected = state.selectedSeats.some(s => s.id === seatId);

          // Add aisle gap after seat 3 and seat 9
          if (col === 4 || col === 10) {
            const aisleGap = document.createElement('div');
            aisleGap.className = 'w-3 sm:w-4';
            seatsInner.appendChild(aisleGap);
          }

          const seatBtn = document.createElement('button');
          seatBtn.type = 'button';
          seatBtn.dataset.seatId = seatId;
          seatBtn.dataset.price = tierPrice;
          seatBtn.dataset.tier = tier;

          let baseClasses = "w-7 h-7 sm:w-8 sm:h-8 rounded-lg text-[10px] font-mono flex items-center justify-center transition transform active:scale-90 ";
          
          if (isSold) {
            seatBtn.disabled = true;
            seatBtn.className = baseClasses + "bg-slate-900 border border-slate-800 text-slate-700 cursor-not-allowed";
            seatBtn.innerHTML = `✕`;
          } else if (isSelected) {
            seatBtn.className = baseClasses + "bg-brand-amber text-black font-extrabold shadow-glow-amber border border-amber-300 scale-105";
            seatBtn.innerHTML = seatId;
          } else {
            if (tier === 'VIP') {
              seatBtn.className = baseClasses + "bg-purple-950/70 border border-purple-800/80 text-purple-300 hover:border-purple-400 hover:bg-purple-900";
            } else if (tier === 'Premium') {
              seatBtn.className = baseClasses + "bg-slate-800 border border-slate-700 text-slate-200 hover:border-brand-amber hover:text-white";
            } else {
              seatBtn.className = baseClasses + "bg-slate-800/70 border border-slate-700/60 text-slate-400 hover:border-slate-500 hover:text-white";
            }
            seatBtn.innerHTML = col;
          }

          seatBtn.onclick = () => toggleSeat(seatId, tier, tierPrice);
          seatsInner.appendChild(seatBtn);
        }

        rowWrapper.appendChild(seatsInner);
        
        // Right side row label
        const labelRight = document.createElement('span');
        labelRight.className = 'w-5 text-[11px] font-bold text-slate-500 text-center';
        labelRight.innerText = rowLetter;
        rowWrapper.appendChild(labelRight);

        container.appendChild(rowWrapper);
      });
    }

    function toggleSeat(seatId, tier, price) {
      soundSeatToggle();
      const existingIdx = state.selectedSeats.findIndex(s => s.id === seatId);
      if (existingIdx > -1) {
        state.selectedSeats.splice(existingIdx, 1);
      } else {
        if (state.selectedSeats.length >= 8) {
          showToast('Maximum 8 seats per booking transaction allowed.');
          return;
        }
        state.selectedSeats.push({ id: seatId, tier, price });
      }
      renderSeatMap();
      updateSeatsSubtotal();
    }

    function updateSeatsSubtotal() {
      const seatsListEl = document.getElementById('selectedSeatsList');
      const seatsSubtotalEl = document.getElementById('seatsSubtotalDisplay');
      
      if (state.selectedSeats.length === 0) {
        seatsListEl.innerText = 'None';
        seatsSubtotalEl.innerText = '$0.00';
      } else {
        seatsListEl.innerText = state.selectedSeats.map(s => s.id).join(', ');
        const total = state.selectedSeats.reduce((sum, s) => sum + s.price, 0);
        seatsSubtotalEl.innerText = `$${total.toFixed(2)}`;
      }
    }

    function renderConcessions() {
      const container = document.getElementById('concessionsGrid');
      container.innerHTML = '';

      snacksData.forEach(snack => {
        const qty = state.selectedSnacks[snack.id] || 0;
        const card = document.createElement('div');
        card.className = "flex items-center justify-between p-3.5 rounded-2xl bg-brand-elevated border border-brand-border/80 hover:border-slate-700 transition";
        card.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-brand-dark/80 border border-brand-border flex items-center justify-center text-brand-amber">
              <i data-lucide="${snack.icon}" class="w-6 h-6"></i>
            </div>
            <div>
              <h5 class="font-display font-semibold text-sm text-white">${snack.name}</h5>
              <p class="text-[11px] text-slate-400 line-clamp-1 max-w-[200px]">${snack.desc}</p>
              <span class="text-xs font-bold text-brand-amber mt-0.5 inline-block">$${snack.price.toFixed(2)}</span>
            </div>
          </div>

          <div class="flex items-center gap-2 bg-brand-dark border border-brand-border rounded-xl p-1">
            <button 
              type="button" 
              onclick="updateSnackQty('${snack.id}', -1)"
              class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center transition"
            >
              -
            </button>
            <span class="w-6 text-center text-xs font-bold text-white">${qty}</span>
            <button 
              type="button" 
              onclick="updateSnackQty('${snack.id}', 1)"
              class="w-7 h-7 rounded-lg bg-brand-amber hover:bg-amber-400 text-black font-bold flex items-center justify-center transition"
            >
              +
            </button>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function updateSnackQty(snackId, change) {
      soundSeatToggle();
      const current = state.selectedSnacks[snackId] || 0;
      const updated = Math.max(0, current + change);
      if (updated === 0) {
        delete state.selectedSnacks[snackId];
      } else {
        state.selectedSnacks[snackId] = updated;
      }
      renderConcessions();
    }

    function navigateStep(direction) {
      soundButtonClick();
      const newStep = state.activeStep + direction;

      // Validation
      if (direction > 0) {
        if (state.activeStep === 1) {
          if (!state.selectedDate || !state.selectedTime) {
            showToast('Please select an active date and showtime');
            return;
          }
        }
        if (state.activeStep === 2) {
          if (state.selectedSeats.length === 0) {
            showToast('Please select at least 1 seat to proceed');
            return;
          }
        }
      }

      if (newStep < 1 || newStep > 4) return;
      state.activeStep = newStep;
      renderCurrentStep();
    }

    function renderCurrentStep() {
      // Toggle tabs
      for (let s = 1; s <= 4; s++) {
        const content = document.getElementById(`stepContent${s}`);
        const tab = document.getElementById(`stepTab${s}`);
        
        if (s === state.activeStep) {
          content.classList.remove('hidden');
          tab.className = 'py-2.5 px-1 border-b-2 border-brand-amber text-brand-amber flex items-center justify-center gap-1.5 font-semibold';
          tab.querySelector('span:first-child').className = 'w-5 h-5 rounded-full bg-brand-amber text-black text-[11px] flex items-center justify-center font-bold';
        } else {
          content.classList.add('hidden');
          const isPassed = s < state.activeStep;
          tab.className = 'py-2.5 px-1 border-b-2 border-transparent text-slate-500 flex items-center justify-center gap-1.5 font-semibold';
          tab.querySelector('span:first-child').className = `w-5 h-5 rounded-full ${isPassed ? 'bg-slate-700 text-slate-300' : 'bg-slate-800 text-slate-500'} text-[11px] flex items-center justify-center font-bold`;
        }
      }

      // Step button label controls
      const prevBtn = document.getElementById('prevStepBtn');
      const nextBtn = document.getElementById('nextStepBtn');
      const metaLabel = document.getElementById('modalMovieMeta');

      if (state.activeStep === 1) {
        prevBtn.classList.add('hidden');
        nextBtn.innerHTML = '<span>Continue to Seats</span><i data-lucide="chevron-right" class="w-4 h-4"></i>';
        metaLabel.innerText = 'Step 1 of 4 • Cinema & Showtime';
      } else if (state.activeStep === 2) {
        prevBtn.classList.remove('hidden');
        nextBtn.innerHTML = '<span>Concessions & Snacks</span><i data-lucide="chevron-right" class="w-4 h-4"></i>';
        metaLabel.innerText = 'Step 2 of 4 • Interactive Seat Selection';
        renderSeatMap();
      } else if (state.activeStep === 3) {
        prevBtn.classList.remove('hidden');
        nextBtn.innerHTML = '<span>Proceed to Checkout</span><i data-lucide="chevron-right" class="w-4 h-4"></i>';
        metaLabel.innerText = 'Step 3 of 4 • Food & Beverage Add-ons';
        renderConcessions();
      } else if (state.activeStep === 4) {
        prevBtn.classList.remove('hidden');
        nextBtn.innerHTML = '<i data-lucide="lock" class="w-4 h-4"></i><span>Authorize & Pay</span>';
        metaLabel.innerText = 'Step 4 of 4 • Order Summary & Verification';
        nextBtn.onclick = confirmBookingAndCheckout;
        buildOrderSummary();
      }

      if (state.activeStep !== 4) {
        nextBtn.onclick = () => navigateStep(1);
      }

      lucide.createIcons();
    }

    function buildOrderSummary() {
      document.getElementById('summaryMovie').innerText = `${state.selectedMovie.title} (${state.selectedFormat})`;
      document.getElementById('summarySchedule').innerText = `${state.selectedDate} @ ${state.selectedTime}`;
      document.getElementById('summarySeats').innerText = state.selectedSeats.map(s => `${s.id} (${s.tier})`).join(', ');

      const snackEntries = Object.entries(state.selectedSnacks);
      if (snackEntries.length === 0) {
        document.getElementById('summarySnacks').innerText = 'None';
      } else {
        const text = snackEntries.map(([id, qty]) => {
          const item = snacksData.find(s => s.id === id);
          return `${qty}x ${item.name}`;
        }).join(', ');
        document.getElementById('summarySnacks').innerText = text;
      }

      // Calculations
      const ticketsTotal = state.selectedSeats.reduce((sum, s) => sum + s.price, 0);
      const snacksTotal = snackEntries.reduce((sum, [id, qty]) => {
        const item = snacksData.find(s => s.id === id);
        return sum + (item.price * qty);
      }, 0);
      const taxes = 2.50;

      let discount = 0;
      if (state.promoApplied) {
        discount = (ticketsTotal + snacksTotal) * 0.20;
      }
      state.discountAmount = discount;

      const grandTotal = Math.max(0, (ticketsTotal + snacksTotal + taxes) - discount);

      document.getElementById('checkoutTicketsSubtotal').innerText = `$${ticketsTotal.toFixed(2)}`;
      document.getElementById('checkoutSnacksSubtotal').innerText = `$${snacksTotal.toFixed(2)}`;
      document.getElementById('checkoutTaxes').innerText = `$${taxes.toFixed(2)}`;

      const discountRow = document.getElementById('discountRow');
      if (state.promoApplied) {
        discountRow.classList.remove('hidden');
        document.getElementById('checkoutDiscount').innerText = `-$${discount.toFixed(2)}`;
      } else {
        discountRow.classList.add('hidden');
      }

      document.getElementById('checkoutGrandTotal').innerText = `$${grandTotal.toFixed(2)}`;
    }

    function applyPromoCode() {
      const code = document.getElementById('promoCodeInput').value.trim().toUpperCase();
      const msg = document.getElementById('promoMessage');
      soundButtonClick();

      if (code === 'CINEMA20') {
        state.promoApplied = true;
        msg.innerText = '✓ Promo "CINEMA20" applied! 20% discount deducted.';
        msg.className = 'text-xs mt-1.5 text-emerald-400 font-semibold block';
        buildOrderSummary();
      } else {
        msg.innerText = 'Invalid voucher code. Try "CINEMA20" for demo discount.';
        msg.className = 'text-xs mt-1.5 text-rose-400 font-medium block';
      }
    }

    function confirmBookingAndCheckout() {
      soundSuccess();

      // Create booking record
      const bookingRef = `#CV-${Math.floor(10000 + Math.random() * 90000)}`;
      const reservation = {
        ref: bookingRef,
        movie: state.selectedMovie.title,
        date: state.selectedDate,
        time: state.selectedTime,
        venue: document.getElementById('venueSelect').value,
        format: state.selectedFormat,
        seats: state.selectedSeats.map(s => s.id),
        timestamp: new Date().toLocaleDateString()
      };

      state.userPurchases.unshift(reservation);
      updateUserPurchasesDrawer();

      // Close booking modal and open ticket modal
      closeBookingModal();

      document.getElementById('passMovieTitle').innerText = reservation.movie;
      document.getElementById('passCinemaVenue').innerText = reservation.venue;
      document.getElementById('passFormat').innerText = reservation.format;
      document.getElementById('passBookingRef').innerText = reservation.ref;
      document.getElementById('passDate').innerText = reservation.date;
      document.getElementById('passTime').innerText = reservation.time;
      document.getElementById('passSeats').innerText = reservation.seats.join(', ');

      const snackItems = Object.entries(state.selectedSnacks);
      if (snackItems.length > 0) {
        const text = snackItems.map(([id, qty]) => {
          const s = snacksData.find(x => x.id === id);
          return `${qty}x ${s.name.split(' ')[0]}`;
        }).join(', ');
        document.getElementById('passSnackText').innerText = text;
      } else {
        document.getElementById('passSnackText').innerText = 'No Concessions added';
      }

      document.getElementById('ticketModal').classList.remove('hidden');
    }

    function printTicketReceipt() {
      soundButtonClick();
      window.print();
    }

    function closeTicketModal() {
      document.getElementById('ticketModal').classList.add('hidden');
    }

    function updateUserPurchasesDrawer() {
      const container = document.getElementById('userTicketsList');
      const badge = document.getElementById('ticketBadge');
      
      if (state.userPurchases.length === 0) {
        badge.classList.add('hidden');
        container.innerHTML = `<p class="text-xs text-slate-400 text-center py-8">No tickets booked yet. Choose a film to start your CineVerse experience!</p>`;
        return;
      }

      badge.innerText = state.userPurchases.length;
      badge.classList.remove('hidden');

      container.innerHTML = '';
      state.userPurchases.forEach(item => {
        const div = document.createElement('div');
        div.className = "p-3.5 rounded-2xl bg-brand-elevated border border-brand-border space-y-2";
        div.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-brand-amber font-mono">${item.ref}</span>
            <span class="text-[10px] text-slate-400">${item.timestamp}</span>
          </div>
          <h4 class="font-display font-bold text-sm text-white">${item.movie}</h4>
          <div class="flex items-center justify-between text-xs text-slate-300">
            <span>${item.date} • ${item.time}</span>
            <span class="text-purple-300 font-semibold">${item.seats.join(', ')}</span>
          </div>
        `;
        container.appendChild(div);
      });
    }

    function toggleTicketsDrawer(open) {
      soundButtonClick();
      const drawer = document.getElementById('ticketsDrawer');
      if (open) drawer.classList.remove('hidden');
      else drawer.classList.add('hidden');
    }

    function startBookingFlow(movie) {
      soundButtonClick();
      state.selectedMovie = movie;
      state.activeStep = 1;
      state.selectedSeats = [];
      state.selectedSnacks = {};
      state.promoApplied = false;

      document.getElementById('modalMovieTitle').innerText = movie.title;
      document.getElementById('bookingModal').classList.remove('hidden');
      
      initDatePills();
      initShowtimes();
      renderCurrentStep();
    }

    function closeBookingModal() {
      document.getElementById('bookingModal').classList.add('hidden');
    }

    function openTrailerModal(title) {
      soundButtonClick();
      document.getElementById('trailerTitle').innerText = `${title} - Official IMAX Trailer`;
      document.getElementById('trailerModal').classList.remove('hidden');
    }

    function closeTrailerModal() {
      document.getElementById('trailerModal').classList.add('hidden');
    }

    function scrollToCatalog() {
      document.getElementById('catalogSection').scrollIntoView({ behavior: 'smooth' });
    }

    // Interactive Toast Notification
    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-6 right-6 z-50 bg-slate-900 border border-brand-amber/50 text-white text-xs px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 animate-bounce';
      toast.innerHTML = `<i data-lucide="info" class="w-4 h-4 text-brand-amber"></i><span>${message}</span>`;
      document.body.appendChild(toast);
      lucide.createIcons();
      setTimeout(() => {
        toast.remove();
      }, 3200);
    }

    // Window load initializations
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      renderMovieCatalog();
    });
  </script>
</body>
</html>
